          "rawSql": "SELECT COALESCE(pc.friendly_name, s.process_name) as app_name, sum(s.duration_sec) as duration FROM monitoring.activity_segments s LEFT JOIN (SELECT arrayJoin(process_names) AS pn, friendly_name FROM monitoring.process_catalog WHERE is_active = 1) AS pc ON lower(s.process_name) = lower(pc.pn) WHERE s.username = '$employee' AND s.timestamp_start >= toDateTime($__from/1000) AND s.timestamp_start <= toDateTime($__to/1000) AND s.state = 'active' GROUP BY app_name ORDER BY duration DESC LIMIT 15",
